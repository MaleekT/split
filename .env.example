NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_SPLIT_CONTRACT=0x...   # Arc Testnet — set after forge deploy

# Payroll (Phase 2) — set after DeployPayroll
NEXT_PUBLIC_SPLIT_PAYROLL_CONTRACT=0x...

# Stealth / private payments (Phase 3) — set after DeployStealth
NEXT_PUBLIC_STEALTH_ANNOUNCER=0x...
NEXT_PUBLIC_STEALTH_REGISTRY=0x...
NEXT_PUBLIC_STEALTH_GATEWAY=0x...

# Server-only — never prefix with NEXT_PUBLIC_
SCHEDULER_PRIVATE_KEY=0x...
DEPLOYER_PRIVATE_KEY=0x...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRON_SECRET=your_random_cron_secret
# Deploy blocks let the indexers skip scanning from genesis (set to each
# contract's deployment block after DeployPayroll / DeployStealth).
PAYROLL_DEPLOY_BLOCK=0
STEALTH_DEPLOY_BLOCK=0
# SKIP_CRON_AUTH=true   # local dev only — never set in production

# Indexer RPC (server-only). Arc's public RPC caps getLogs at a 10k span and
# rate-limits bursts, which makes a backlog effectively unclearable. Point this
# at a provider with wider limits and raise ARC_LOGS_MAX_SPAN to match.
ARC_INDEXER_RPC=https://rpc.blockdaemon.testnet.arc.network
ARC_LOGS_MAX_SPAN=99000
